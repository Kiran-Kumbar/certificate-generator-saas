# ==============================================================================
# SOFTMUSK CERTIFICATE SAAS - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. DATABASE (MongoDB Atlas Cloud Database)
# In production, create a free M0 cluster on https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/certificate_saas?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/certificate_saas

# 2. PUBLIC APPLICATION URL
# Used for generating public QR codes that mobile phones scan to verify credentials.
# In production, set to your Vercel URL or custom domain:
# e.g., https://smc.onqeva.in
NEXT_PUBLIC_APP_URL=https://smc.onqeva.in

# 3. SECURITY & AUTHENTICATION
# Strong secret key used for signing JWT session tokens.
# Generate in terminal: openssl rand -base64 32
JWT_SECRET=certificate-saas-super-secret-production-jwt-key-change-this

# 4. CLOUD MEDIA & PDF ASSET STORAGE (Cloudinary)
# In production on Vercel (serverless), local disk is read-only and ephemeral.
# Cloudinary securely stores all issued certificate PDFs, PNG previews, and signature stamps.
# Sign up for free (25GB storage/month) at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 5. OPTIONAL: SUPER ADMIN SEEDING (First time setup)
# Credentials used if you access /super-admin
SUPER_ADMIN_EMAIL=admin@softmusk.com
SUPER_ADMIN_PASSWORD=change_this_admin_password_123
